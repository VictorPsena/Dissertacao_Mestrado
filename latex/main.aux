\@writefile{lof}{\contentsline {figure}{\numberline {1.20}{\ignorespaces Exemplo de convolução bidimensional. A matriz de entrada $X$ (matriz $7\times 7$) é convoluída com o \textit  {kernel} $W$ (matriz $2\times 2$) para produzir a saída $S$ (matriz $6\times 6$). O \textit  {kernel} é ``deslizado'' sobre a matriz de entrada, formando sub-matrizes, e em cada posição, a soma ponderada dos valores dos pixels cobertos pelo \textit  {kernel} é calculada e o resultado é aplicado em uma função de ativação ($\sigma $) para gerar o valor correspondente ($\hat  {y}_{11}$) na matriz de saída. $b$ sendo o viés adicionado à soma ponderada.}}{50}{figure.caption.29}\protected@file@percent }
\newlabel{conv2d}{{1.20}{50}{Exemplo de convolução bidimensional. A matriz de entrada $X$ (matriz $7\times 7$) é convoluída com o \textit {kernel} $W$ (matriz $2\times 2$) para produzir a saída $S$ (matriz $6\times 6$). O \textit {kernel} é ``deslizado'' sobre a matriz de entrada, formando sub-matrizes, e em cada posição, a soma ponderada dos valores dos pixels cobertos pelo \textit {kernel} é calculada e o resultado é aplicado em uma função de ativação ($\sigma $) para gerar o valor correspondente ($\hat {y}_{11}$) na matriz de saída. $b$ sendo o viés adicionado à soma ponderada}{figure.caption.29}{}}
\newlabel{largura_conv}{{1.24}{50}{Convolução}{equation.1.3.24}{}}
\newlabel{altura_conv}{{1.25}{50}{Convolução}{equation.1.3.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.21}{\ignorespaces Aplicações de diferentes \textit  {kernels} em uma imagem. A imagem original é representada em (a), juntamente com o \textit  {kernel} identidade, que não faz modificações. Em (b) a imagem passou por um \textit  {kernel} que aumenta a nitidez reforçando o pixel central e aumentando a diferença dele em relação à sua vizinhança. Em (c) foi usado um \textit  {kernel} de desfoque, que substitui um pixel pela média dele com seus vizinhos. A imagem em (d) é o resultado de aplicar na imagem em escala de cinza um \textit  {kernel} que reforça suas linhas verticais, enquanto (e) reforça suas linhas horizontais. O \textit  {kernel} em (f) reforça os contornos (bordas) da imagem.}}{51}{figure.caption.30}\protected@file@percent }
\newlabel{convolucao}{{1.21}{51}{Aplicações de diferentes \textit {kernels} em uma imagem. A imagem original é representada em (a), juntamente com o \textit {kernel} identidade, que não faz modificações. Em (b) a imagem passou por um \textit {kernel} que aumenta a nitidez reforçando o pixel central e aumentando a diferença dele em relação à sua vizinhança. Em (c) foi usado um \textit {kernel} de desfoque, que substitui um pixel pela média dele com seus vizinhos. A imagem em (d) é o resultado de aplicar na imagem em escala de cinza um \textit {kernel} que reforça suas linhas verticais, enquanto (e) reforça suas linhas horizontais. O \textit {kernel} em (f) reforça os contornos (bordas) da imagem}{figure.caption.30}{}}
